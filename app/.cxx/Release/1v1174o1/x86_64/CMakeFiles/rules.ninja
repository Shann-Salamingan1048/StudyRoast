rule CLEAN
  command = /home/shann/Android/Sdk/cmake/3.31.6/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/shann/Android/Sdk/cmake/3.31.6/bin/ninja -t targets
  description = All primary targets available:

